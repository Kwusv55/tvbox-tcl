<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4A2850" />
            <stroke android:width="1dp" android:color="#EF6AA7" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#203C55" />
            <stroke android:width="2dp" android:color="#56E0F0" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#211B38" />
            <stroke android:width="1dp" android:color="#342D50" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
