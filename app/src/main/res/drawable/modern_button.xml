<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F708D" />
            <stroke android:width="2dp" android:color="#B8F0FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1C536C" />
            <stroke android:width="2dp" android:color="#56D6FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#16394D" />
            <stroke android:width="1dp" android:color="#28556A" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
